# Copy to .env and fill in your own values.
# The same backend as Project 1 works here — commandcode.ai is
# OpenAI-compatible, so any OpenAI-style endpoint is supported.

CODEGUARD_API_KEY=your-api-key-here
CODEGUARD_BASE_URL=https://api.commandcode.ai/provider/v1
CODEGUARD_MODEL=deepseek/deepseek-v4.1-flash

# Loop and sandbox limits
CODEGUARD_MAX_ITERATIONS=3
CODEGUARD_PYTEST_TIMEOUT=30
CODEGUARD_REQUEST_TIMEOUT=120

# Sampling: the coder may vary slightly, the judge must not vary at all.
CODEGUARD_CODER_TEMPERATURE=0.2
CODEGUARD_REVIEWER_TEMPERATURE=0.0
