{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["static/**", "src/**", "requirements.txt"]
      }
    }
  ],
  "routes": [
    { "src": "/scan", "dest": "api.py" },
    { "src": "/validate-code", "dest": "api.py" },
    { "src": "/health", "dest": "api.py" },
    { "src": "/docs", "dest": "api.py" },
    { "src": "/openapi.json", "dest": "api.py" },
    { "src": "/(.*)", "dest": "api.py" }
  ]
}
